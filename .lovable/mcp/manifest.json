{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://lamohcoijkpigygiqyih.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "umoja-mcp",
      "version": "0.1.0",
      "title": "UMOJA"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Who am I",
        "description": "Return the signed-in UMOJA member's profile (name, email, country, sparks balance, KYC status).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_spark_purchases",
        "title": "List my Spark Trade purchases",
        "description": "List the signed-in member's Spark Trade product reservations/purchases with status, units, capital allocated, and payment reference.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max rows to return (default 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "status": {
              "description": "Optional reservation_status filter, e.g. 'paid', 'reserved', 'shipped'.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_platform_info",
        "title": "Get UMOJA platform info",
        "description": "Return public UMOJA platform info: current bank details, payment instructions, and active circle payout tiers.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
